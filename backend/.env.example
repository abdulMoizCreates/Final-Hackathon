MONGO_URI=mongodb://localhost:27017/hackathon-starter
JWT_SECRET=your-jwt-secret-change-me
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-me
PORT=5001
CLIENT_ORIGIN=http://localhost:3000

# Gemini API — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: any Gemini API model id (e.g. gemini-3.6-flash or gemini-3.8-flash);
# defaults to gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
